<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="5dp"
    android:minHeight="64dp" android:focusable="true" android:clickable="true"
    app:cardBackgroundColor="@color/panel" app:cardCornerRadius="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/title" style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" />
        <TextView android:id="@+id/body" style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/metadata" style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/petroleum" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
