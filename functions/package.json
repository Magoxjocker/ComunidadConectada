{
  "name": "comunidad-conectada-backend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": { "node": "22" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:rules": "node --test integration/rules.test.js",
    "test:flows": "node --test --test-force-exit --test-concurrency=1 integration/flows.test.js integration/provision-admin.test.js",
    "admin": "node provision-admin.js",
    "spark:rules": "node generate-spark-rules.js",
    "spark:delivery": "node spark-delivery.js",
    "spark:delivery:watch": "node spark-local-delivery.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.14.0"
  },
  "overrides": {
    "firebase-admin@14.5.1": {
      "@firebase/database-compat": "2.1.7"
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
